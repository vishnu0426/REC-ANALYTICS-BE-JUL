# Copy to .env for local (non-docker) runs. In docker-compose these are
# already injected as environment variables — this file matters mainly if
# you run `uvicorn app.main:app` directly on your host.

DATABASE_URL=postgresql+psycopg://postgresql:postgres@localhost:5433/AgnoCall
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=AgnoCall
MINIO_SECRET_KEY=AgnoCall123
MINIO_BUCKET=call-recordings
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000

# cloud | air_gapped | hybrid — see ADR-001 in the architecture docs
DEPLOYMENT_MODE=hybrid

# Required for the LLM analysis stage when DEPLOYMENT_MODE is cloud/hybrid.
# Leave blank and set DEPLOYMENT_MODE=air_gapped to route through Ollama instead.
OPENAI_API_KEY=

# Which cloud STT provider to use: deepgram | google | mock
# Falls back to MockSTTProvider automatically if the selected provider's
# credentials below are left blank.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Path to a Google Cloud service account JSON key (used only if STT_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS=
